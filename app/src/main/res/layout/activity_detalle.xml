<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DetalleActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imgCaratulaDetalle"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:contentDescription="@string/caratula_desc"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/txtCancionDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cancion_ejemplo_titulo"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtArtistaDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancion_ejemplo_artista"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/txtGeneroDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detalle_ejemplo_genero" />

        <TextView
            android:id="@+id/txtVecesDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/detalle_ejemplo_veces"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btnPlayDetalle"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/escuchar_preview_desc"
            android:src="@android:drawable/ic_media_play" />

        <Switch
            android:id="@+id/swFavoritaDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checked="true"
            android:text="@string/detalle_favorita" />

        <Button
            android:id="@+id/btnEliminarDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:onClick="btnEliminarOnClick"
            android:text="@string/detalle_eliminar" />
    </LinearLayout>

</ScrollView>
